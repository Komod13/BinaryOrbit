PORT=8787
# 高德 Web端(JS API) key，前端渲染地图用
AMAP_JS_KEY=
# 对应安全密钥 jscode，只在服务端使用
AMAP_SECURITY_CODE=
# 高德 Web服务 key，后端检索 POI / 逆地理用
AMAP_WEB_KEY=
# 低档上限（元/人）
PRICE_TIER_LOW=60
# 高档下限（元/人）
PRICE_TIER_HIGH=150
# 可选：手机访问用的局域网地址。
# 默认自动挑（192.168 网段优先，跳过 Clash / WSL / VMware 这类虚拟网卡）；
# 如果手机还是连不上，就把正确的地址写在这里，例如 LAN_IP=192.168.88.209
LAN_IP=
# 底图文字注记：auto（默认，低 zoom 显示城市名、高 zoom 隐藏）/ on / off
# iPad 上高 zoom 的矢量注记会把主线程占住 300ms+，auto 是实测最平衡的取值
MAP_LABELS=auto
# auto 模式下注记显示的 zoom 上限（低于它才显示），3–18
MAP_LABEL_MAX_ZOOM=12
